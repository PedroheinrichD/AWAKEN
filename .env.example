DATABASE_URL="postgresql://postgres:@localhost:5432/awaken"
# Only needed with a pooled DATABASE_URL (e.g. Supabase's transaction-mode pooler); the
# Prisma CLI uses this for migrations instead. Point it at a non-pooled connection.
DIRECT_URL="postgresql://postgres:@localhost:5432/awaken"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
NODE_ENV=development

VITE_GOOGLE_MAPS_API_KEY=
